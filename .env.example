# 名前だけ。値は .env に書く（.env はコミットしない）

# Claude API（サーバー側だけで使う）
ANTHROPIC_API_KEY=
AGENT_MODEL=
HEAVY_MODEL=
USAGE_SWITCH_USD=

# Slack ボット（npm run slack。練習用ワークスペース専用）
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_REQUEST_CHANNEL=
# 任意：練習用ワークスペースの team id。書くと、ほかのワークスペースでは起動しない
SLACK_ALLOWED_TEAM_ID=
# 任意：窓口のURL（既定 http://localhost:3000）
INBOX_BASE_URL=
