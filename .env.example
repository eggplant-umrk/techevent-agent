# 名前だけ。値は .env に書く（.env はコミットしない）

# Claude API（サーバー側だけで使う）
ANTHROPIC_API_KEY=
AGENT_MODEL=
HEAVY_MODEL=
USAGE_SWITCH_USD=

# Slack ボット（npm run slack。練習用ワークスペース専用）
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_REQUEST_CHANNEL=
# 技術広報だけが入る非公開チャンネルの id（ボットを招待しておく）。準備ができた依頼の通知（決まった文と画面へのリンクだけ）を送る。書かなければ通知しない
SLACK_NOTIFY_CHANNEL=
# 練習用ワークスペースの team id。書くと、ほかのワークスペースでは起動しない
# 本番（練習用ワークスペースで実際に動かすとき）では必ず設定する。空にできるのは動作確認のときだけ
SLACK_ALLOWED_TEAM_ID=
# 任意：窓口のURL（既定 http://127.0.0.1:3000。dev サーバーは 127.0.0.1 だけで待ち受けるので localhost にしない）
INBOX_BASE_URL=

# 任意：デモ用に開発者本人を架空の会社の31人目として入れる（on）。評価は常に30人
DEMO_PERSON=

# 任意：本人のカレンダー（iCal 形式の非公開 URL）。秘密なので表示・ログ・コミットしない。DATA_SOURCE=github か DEMO_PERSON=on のときだけ使う
CALENDAR_ICS_URL=

# 任意：「ネタ帳を更新」1回の金額の上限（USD、既定 1）。流す前の見積もりがこれを超えると、API を呼ばずに止める
NOTEBOOK_BUDGET_USD=
# 任意：1人分として1回に渡す活動の件数・文字数・1件の本文の長さの上限（既定 60・20000・400）。超えた古い分は次回に回す
NOTEBOOK_MAX_ITEMS=
NOTEBOOK_MAX_CHARS=
NOTEBOOK_BODY_CHARS=

# 任意：日程が決まっていない依頼で「空いていそうな日」を探す時間帯（日本時間・平日、既定 19〜21時）
DATE_SUGGEST_START_HOUR=
DATE_SUGGEST_END_HOUR=
# 任意：年末年始（12/29〜1/3）を会社の休みとして除くのをやめるときは off（既定は除く）
DATE_SUGGEST_YEAR_END_OFF=

# 任意：別の端末に見せるとき（README の「メンターなどに別の端末から見せる」）。既定（空）は同じ端末からだけ
# lan にすると、同じネットワークから受け付ける。ACCESS_CODE（合言葉）が空なら起動しない。値は表示・コミットしない
SHARE_MODE=
ACCESS_CODE=
# 任意：見せている間（起動してから）の API 代の上限（USD）。超えたら API を使う操作を止める
SHARE_BUDGET_USD=
# 任意：待ち受け先（既定 127.0.0.1。SHARE_MODE=lan で空なら、この端末の LAN の IP）
BIND_HOST=

# 任意：ネタ帳の材料として読む Slack の公開チャンネルの id（カンマ区切り。C で始まる）。設定がなければ読まない。トークンは SLACK_BOT_TOKEN を使う
SLACK_SOURCE_CHANNELS=
