# 名前だけ。値は .env に書く（.env はコミットしない）

# Claude API（サーバー側だけで使う）
ANTHROPIC_API_KEY=
AGENT_MODEL=
HEAVY_MODEL=
USAGE_SWITCH_USD=

# Slack ボット（npm run slack。練習用ワークスペース専用）
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_REQUEST_CHANNEL=
# 技術広報だけが入る非公開チャンネルの id（ボットを招待しておく）。準備ができた依頼の通知（決まった文と画面へのリンクだけ）を送る。書かなければ通知しない
SLACK_NOTIFY_CHANNEL=
# 練習用ワークスペースの team id。書くと、ほかのワークスペースでは起動しない
# 本番（練習用ワークスペースで実際に動かすとき）では必ず設定する。空にできるのは動作確認のときだけ
SLACK_ALLOWED_TEAM_ID=
# 任意：窓口のURL（既定 http://127.0.0.1:3000。dev サーバーは 127.0.0.1 だけで待ち受けるので localhost にしない）
INBOX_BASE_URL=

# 任意：デモ用に開発者本人を架空の会社の31人目として入れる（on）。評価は常に30人
DEMO_PERSON=

# 任意：本人のカレンダー（iCal 形式の非公開 URL）。秘密なので表示・ログ・コミットしない。DATA_SOURCE=github か DEMO_PERSON=on のときだけ使う
CALENDAR_ICS_URL=

# 任意：「ネタ帳を更新」1回の金額の上限（USD、既定 1）。流す前の見積もりがこれを超えると、API を呼ばずに止める
NOTEBOOK_BUDGET_USD=
# 任意：1人分として1回に渡す活動の件数・文字数・1件の本文の長さの上限（既定 60・20000・400）。超えた古い分は次回に回す
NOTEBOOK_MAX_ITEMS=
NOTEBOOK_MAX_CHARS=
NOTEBOOK_BODY_CHARS=

# 任意：日程が決まっていない依頼で「空いていそうな日」を探す時間帯（日本時間・平日、既定 19〜21時）
DATE_SUGGEST_START_HOUR=
DATE_SUGGEST_END_HOUR=
# 任意：年末年始（12/29〜1/3）を会社の休みとして除くのをやめるときは off（既定は除く）
DATE_SUGGEST_YEAR_END_OFF=

# 見せる用（npm run start:share、README の「会場の参加者に触ってもらう」）。発表用（npm start）とは別のサーバー・別の置き場で動く
# 合言葉は会場の全員に公開する前提。12文字以上（例：netacho-1122-hanami）。ACCESS_CODE が12文字未満か SHARE_BUDGET_USD が空なら、見せる用は起動しない。値は表示・コミットしない
ACCESS_CODE=
# 見せている間（起動してから）の API 代の上限（USD、例：5）。超えたら API を使う操作を止める
SHARE_BUDGET_USD=
# 任意：見せる用の1人（合言葉で入ったブラウザ）あたりの API 代の上限（USD、例：5）。超えたらその人だけ API を使う操作を止める。
# 合計の上限 SHARE_BUDGET_USD はそのまま効く（cookie を消せば数え直せてしまうため）。空なら人ごとには止めない
SHARE_PER_PERSON_USD=
# 任意：メンター用の合言葉（12文字以上、ACCESS_CODE と別のもの）。一般の合言葉と同じ守り（回数の制限・全体の上限・値を表示しない）。
# これで入った人は1人あたりの上限が SHARE_MENTOR_USD になり、使われた結果・実行の記録に role: "mentor" が付く（画面の見た目は同じ）。
# メンター・審査員には、発表用の画面 /share-links の「メンター・審査員用のリンク（運営さんに渡す用）」を運営さん経由で渡す。Notion やスライドには書かない（口頭で伝えてもよい）。
# Notion に貼るのは一般用のリンク（/share-links の「Notion に貼る用」）
MENTOR_ACCESS_CODE=
# 任意：メンターの1人あたりの API 代の上限（USD、例：15）。空なら SHARE_PER_PERSON_USD と同じ
SHARE_MENTOR_USD=
# 任意：見せる用の側ごとの合計の上限（USD）。一般の参加者の分（例：20）と、メンター・審査員の分（例：30）。
# 届いたらその側だけ API を使う操作を止める（一般が使い切ってもメンターは試せる）。合計の上限 SHARE_BUDGET_USD はそのまま効く。空ならその側には付けない
SHARE_GENERAL_POOL_USD=
SHARE_MENTOR_POOL_USD=
# 任意：見せる用の待ち受け先・ポート・置き場（既定 0.0.0.0・3100・data/runtime-share）
SHARE_BIND_HOST=
SHARE_PORT=
SHARE_DATA_DIR=
# 任意：API を使う操作の同時実行の上限（既定 2。超えたら 429 で断る。発表用と見せる用でそれぞれ数える）
API_MAX_CONCURRENT=
# 任意：発表用の待ち受け先（既定 127.0.0.1。localhost だけ）とポート（既定 3000）
BIND_HOST=
PORT=

# 任意：ネタ帳の材料として読む Slack の公開チャンネルの id（カンマ区切り。C で始まる）。設定がなければ読まない。トークンは SLACK_BOT_TOKEN を使う
SLACK_SOURCE_CHANNELS=
